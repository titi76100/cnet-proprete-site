---
import { ArrowRight, Gift } from '@lucide/astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import AppMockup from '@/components/mockups/AppMockup.astro';
import { ctaDemo } from '@/config/site';
---

<section class="relative overflow-hidden bg-gradient-to-b from-brand-50 via-white to-white">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 right-0 size-[36rem] rounded-full bg-fresh-100/60 blur-3xl"
  ></div>
  <Container class="relative grid items-center gap-14 py-16 sm:py-20 lg:grid-cols-2 lg:py-24">
    <div>
      <p class="inline-flex items-center rounded-full bg-white px-3 py-1 text-xs font-semibold text-fresh-700 ring-1 ring-fresh-200">
        Entreprises de nettoyage & structures d’insertion
      </p>
      <h1 class="mt-5 text-4xl leading-[1.1] font-extrabold sm:text-5xl lg:text-[3.4rem]">
        Le logiciel de gestion pensé pour les{' '}
        <span class="text-fresh-700">métiers de la propreté</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
        Salariés et plannings, contrôles qualité, signalements, commandes de matériel, clés et
        badges, remplacements et messages internes : CNet Propreté réunit la gestion de vos équipes
        et de vos sites dans un seul outil.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href={ctaDemo.href} size="lg">
          {ctaDemo.label}
        </Button>
        <Button href="/fonctionnalites" variant="secondary" size="lg">
          Découvrir les fonctionnalités
          <ArrowRight class="size-4" aria-hidden="true" />
        </Button>
      </div>
      <p class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-brand-700">
        <Gift class="size-4 text-fresh-700" aria-hidden="true" />
        Essai gratuit de 30 jours
      </p>
    </div>
    <AppMockup />
  </Container>
</section>
