---
import { Users, HeartHandshake, ArrowRight, Check } from '@lucide/astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';

// [À VALIDER] Formulations à relire par CNet Propreté.
// Elles s'appuient uniquement sur les modules listés, sans fonctionnalité supplémentaire.
const audiences = [
  {
    icon: Users,
    title: 'Entreprises de nettoyage',
    href: '/solutions/entreprises-de-nettoyage',
    points: [
      'Organiser les plannings de vos équipes sur l’ensemble de vos sites',
      'Suivre la qualité de vos prestations grâce aux contrôles',
      'Anticiper les absences et organiser les remplacements',
    ],
  },
  {
    icon: HeartHandshake,
    title: 'Structures d’insertion',
    href: '/solutions/structures-insertion',
    points: [
      'Coordonner les encadrants techniques et les salariés en parcours',
      'Attribuer à chacun des accès adaptés à son rôle',
      'Centraliser signalements, matériel, clés et badges des chantiers',
    ],
  },
];
---

<section class="py-20 sm:py-24" aria-labelledby="audiences-title">
  <Container>
    <SectionHeading
      id="audiences-title"
      eyebrow="Pour qui ?"
      title="Conçu pour deux réalités de terrain"
    />
    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      {audiences.map((a) => (
        <article class="flex flex-col rounded-2xl border border-line bg-white p-8 shadow-card">
          <span class="grid size-12 place-items-center rounded-xl bg-brand-700 text-white">
            <a.icon class="size-6" aria-hidden="true" />
          </span>
          <h3 class="mt-6 text-2xl font-bold">{a.title}</h3>
          <ul class="mt-5 flex-1 space-y-3">
            {a.points.map((p) => (
              <li class="flex gap-3 text-muted">
                <Check class="mt-0.5 size-5 shrink-0 text-fresh-600" aria-hidden="true" />
                <span>{p}</span>
              </li>
            ))}
          </ul>
          <a
            href={a.href}
            class="mt-8 inline-flex items-center gap-1 font-semibold text-fresh-700 hover:text-fresh-800"
          >
            Découvrir la solution
            <ArrowRight class="size-4" aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>
  </Container>
</section>
