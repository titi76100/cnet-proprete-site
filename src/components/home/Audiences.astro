---
import { Users, HeartHandshake, ArrowRight, Check } from '@lucide/astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { audiences } from '@/config/site';

interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  background?: 'white' | 'surface';
}

const {
  eyebrow = 'Pour qui ?',
  title = 'Conçu pour deux réalités de terrain',
  intro,
  background = 'white',
} = Astro.props;

const icons = { nettoyage: Users, insertion: HeartHandshake } as const;
---

<section
  class:list={['py-20 sm:py-24', background === 'surface' && 'bg-surface']}
  aria-labelledby="audiences-title"
>
  <Container>
    <SectionHeading id="audiences-title" eyebrow={eyebrow} title={title} intro={intro} />
    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      {audiences.map((a) => {
        const Icon = icons[a.key];
        return (
          <article class="flex flex-col rounded-2xl border border-line bg-white p-8 shadow-card">
            <span class="grid size-12 place-items-center rounded-xl bg-brand-700 text-white">
              <Icon class="size-6" aria-hidden="true" />
            </span>
            <h3 class="mt-6 text-2xl font-bold">{a.title}</h3>
            <ul class="mt-5 flex-1 space-y-3">
              {a.points.map((p) => (
                <li class="flex gap-3 text-muted">
                  <Check class="mt-0.5 size-5 shrink-0 text-fresh-600" aria-hidden="true" />
                  <span>{p}</span>
                </li>
              ))}
            </ul>
            <a
              href={a.href}
              class="mt-8 inline-flex items-center gap-1 font-semibold text-fresh-700 hover:text-fresh-800"
            >
              Découvrir la solution
              <span class="sr-only"> pour les {a.title.toLowerCase()}</span>
              <ArrowRight class="size-4" aria-hidden="true" />
            </a>
          </article>
        );
      })}
    </div>
  </Container>
</section>
