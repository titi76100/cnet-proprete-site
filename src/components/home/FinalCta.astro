---
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import { ctaDemo, type NavLink } from '@/config/site';

interface Props {
  title?: string;
  text?: string;
  secondary?: NavLink;
}

const {
  title = 'Voyons ensemble si CNet Propreté correspond à votre organisation',
  text = 'Présentez-nous vos équipes, vos sites et vos besoins : nous vous montrons le logiciel en situation.',
  secondary = { label: 'Nous contacter', href: '/contact' },
} = Astro.props;
---

<section class="relative overflow-hidden bg-brand-700 py-20 sm:py-24">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-32 -left-24 size-[28rem] rounded-full bg-fresh-500/20 blur-3xl"
  ></div>
  <Container size="narrow" class="relative text-center">
    <h2 class="text-3xl font-bold text-white! sm:text-4xl">{title}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-brand-100">{text}</p>
    <slot />
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <Button href={ctaDemo.href} size="lg">
        {ctaDemo.label}
      </Button>
      <Button href={secondary.href} variant="inverse" size="lg">
        {secondary.label}
      </Button>
    </div>
  </Container>
</section>
