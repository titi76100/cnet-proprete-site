---
/**
 * Schéma : les 9 modules validés réunis autour d'une base commune.
 * Illustration de principe, pas une capture du logiciel.
 */
import { Monitor, Smartphone, TabletSmartphone } from '@lucide/astro';
import ModuleIcon from '@/components/ui/ModuleIcon.astro';
import { modules } from '@/config/site';
---

<figure class="relative mx-auto w-full max-w-xl lg:max-w-none">
  <div
    role="img"
    aria-label="Schéma : les neuf modules de CNet Propreté réunis dans un même logiciel, accessible sur Windows, Android et iOS."
    class="relative rounded-2xl border border-line bg-white p-5 shadow-lift sm:p-7"
  >
    <div aria-hidden="true">
      <div class="mx-auto flex w-fit items-center gap-3 rounded-xl bg-brand-700 px-5 py-3 text-white shadow-card">
        <svg viewBox="0 0 32 32" class="size-8 shrink-0" focusable="false">
          <rect width="32" height="32" rx="8" fill="#ffffff"></rect>
          <path
            d="M16 6.5c3.6 4.3 6.5 8.1 6.5 11.6a6.5 6.5 0 0 1-13 0c0-3.5 2.9-7.3 6.5-11.6Z"
            fill="#0D9488"
          ></path>
        </svg>
        <span class="font-display text-base leading-tight">
          <span class="block font-extrabold">CNet Propreté</span>
          <span class="block text-xs font-medium text-brand-100">Une base commune</span>
        </span>
      </div>

      <div class="mx-auto h-6 w-px border-l-2 border-dashed border-fresh-300"></div>

      <ul class="grid grid-cols-3 gap-2 rounded-xl bg-surface p-2 sm:gap-2.5 sm:p-3">
        {modules.map((m) => (
          <li class="flex flex-col items-center gap-1.5 rounded-lg bg-white px-1.5 py-3 text-center ring-1 ring-line">
            <span class="grid size-8 place-items-center rounded-md bg-fresh-50 text-fresh-700">
              <ModuleIcon slug={m.slug} class="size-4" />
            </span>
            <span class="text-[0.6875rem] leading-tight font-semibold text-brand-800 sm:text-xs">
              {m.label}
            </span>
          </li>
        ))}
      </ul>

      <div class="mx-auto h-6 w-px border-l-2 border-dashed border-fresh-300"></div>

      <div class="flex flex-wrap items-center justify-center gap-2 text-xs font-medium text-brand-700">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1.5">
          <Monitor class="size-3.5" /> Windows
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1.5">
          <Smartphone class="size-3.5" /> Android
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1.5">
          <TabletSmartphone class="size-3.5" /> iOS
        </span>
      </div>
    </div>
  </div>
  <figcaption class="mt-3 text-right text-xs text-muted">Schéma de principe.</figcaption>
</figure>
