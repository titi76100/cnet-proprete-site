---
/**
 * Illustration de l'interface, dessinée en HTML/CSS avec des données fictives neutres.
 * Ce n'est PAS une capture du logiciel : elle sera remplacée par de vraies captures.
 */
import { CalendarDays, ClipboardCheck, CircleCheck } from '@lucide/astro';

const days = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven'];
const rows = [
  { who: 'Équipe A', slots: [1, 1, 0, 1, 1] },
  { who: 'Équipe B', slots: [0, 1, 1, 1, 0] },
  { who: 'Équipe C', slots: [1, 0, 1, 0, 1] },
  { who: 'Équipe D', slots: [1, 1, 1, 0, 0] },
];
const tones = ['bg-fresh-100 text-fresh-800', 'bg-brand-100 text-brand-700'];
---

<figure class="relative mx-auto w-full max-w-xl lg:max-w-none">
  <div aria-hidden="true">
    <!-- Fenêtre « ordinateur » -->
    <div class="overflow-hidden rounded-xl border border-line bg-white shadow-lift">
      <div class="flex items-center gap-1.5 border-b border-line bg-surface px-4 py-2.5">
        <span class="size-2.5 rounded-full bg-slate-300"></span>
        <span class="size-2.5 rounded-full bg-slate-300"></span>
        <span class="size-2.5 rounded-full bg-slate-300"></span>
        <span class="ml-3 h-4 w-40 rounded bg-white"></span>
      </div>
      <div class="flex">
        <div class="hidden w-28 shrink-0 space-y-2 border-r border-line p-3 sm:block">
          <div class="h-2.5 w-16 rounded bg-brand-700"></div>
          {[70, 55, 62, 48, 58, 40].map((w, i) => (
            <div
              class:list={['h-2 rounded', i === 0 ? 'bg-fresh-400' : 'bg-slate-200']}
              style={`width:${w}%`}
            />
          ))}
        </div>
        <div class="flex-1 p-4">
          <div class="flex items-center gap-2 text-brand-800">
            <CalendarDays class="size-4" />
            <span class="text-xs font-semibold">Planning de la semaine</span>
            <span class="ml-auto h-2 w-14 rounded bg-slate-200"></span>
          </div>
          <div class="mt-3 grid grid-cols-[4.5rem_repeat(5,1fr)] gap-1.5 text-[0.625rem]">
            <span></span>
            {days.map((d) => (
              <span class="text-center font-medium text-muted">{d}</span>
            ))}
            {rows.map((r, ri) => (
              <>
                <span class="truncate self-center font-medium text-brand-800">{r.who}</span>
                {r.slots.map((on, si) => (
                  <span
                    class:list={[
                      'h-7 rounded-md',
                      on ? tones[(ri + si) % 2] : 'border border-dashed border-line',
                    ]}
                  />
                ))}
              </>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Fenêtre « téléphone » -->
    <div class="absolute -bottom-8 -left-2 w-40 rounded-[1.4rem] border-4 border-brand-800 bg-white p-3 shadow-lift sm:-left-6 sm:w-44">
      <div class="mx-auto mb-2 h-1 w-10 rounded-full bg-slate-200"></div>
      <div class="flex items-center gap-1.5 text-brand-800">
        <ClipboardCheck class="size-3.5" />
        <span class="text-[0.625rem] font-semibold">Contrôle qualité</span>
      </div>
      <ul class="mt-2 space-y-1.5">
        {[true, true, false].map((ok) => (
          <li class="flex items-center gap-1.5">
            <CircleCheck
              class:list={['size-3.5 shrink-0', ok ? 'text-fresh-600' : 'text-slate-300']}
            />
            <span class="h-1.5 flex-1 rounded bg-slate-200" />
          </li>
        ))}
      </ul>
      <div class="mt-3 h-5 rounded-md bg-fresh-600"></div>
    </div>
  </div>
  <figcaption class="mt-12 text-right text-xs text-muted">
    Illustration non contractuelle — captures du logiciel à venir.
  </figcaption>
</figure>
