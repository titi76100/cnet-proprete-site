---
/**
 * Logo PROVISOIRE : pictogramme « goutte » + nom.
 * À remplacer par le logo définitif de CNet Propreté.
 */
interface Props {
  tone?: 'dark' | 'light';
  class?: string;
}
const { tone = 'dark', class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg viewBox="0 0 32 32" class="size-9 shrink-0" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="8" fill={tone === 'dark' ? '#0B3B60' : '#ffffff'}></rect>
    <path
      d="M16 6.5c3.6 4.3 6.5 8.1 6.5 11.6a6.5 6.5 0 0 1-13 0c0-3.5 2.9-7.3 6.5-11.6Z"
      fill={tone === 'dark' ? '#2DD4BF' : '#0D9488'}
    ></path>
    <path
      d="M13.2 18.6a2.8 2.8 0 0 0 2.8 2.8"
      stroke={tone === 'dark' ? '#ffffff' : '#ffffff'}
      stroke-width="1.8"
      stroke-linecap="round"
      fill="none"
    ></path>
  </svg>
  <span
    class:list={[
      'font-display text-lg leading-none tracking-tight',
      tone === 'dark' ? 'text-brand-700' : 'text-white',
    ]}
  >
    <span class="font-extrabold">CNet</span> <span class="font-medium">Propreté</span>
  </span>
</span>
