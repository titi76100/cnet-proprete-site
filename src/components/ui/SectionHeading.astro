---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  tone?: 'dark' | 'light';
  id?: string;
}
const { eyebrow, title, intro, align = 'center', tone = 'dark', id } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && (
    <p
      class:list={[
        'text-sm font-semibold tracking-wide uppercase',
        tone === 'dark' ? 'text-fresh-700' : 'text-fresh-300',
      ]}
    >
      {eyebrow}
    </p>
  )}
  <h2
    id={id}
    class:list={['mt-2 text-3xl font-bold sm:text-4xl', tone === 'light' && 'text-white!']}
  >
    {title}
  </h2>
  {intro && (
    <p class:list={['mt-4 text-lg', tone === 'dark' ? 'text-muted' : 'text-brand-100']}>{intro}</p>
  )}
</div>
