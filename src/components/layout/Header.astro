---
import { ChevronDown, Menu, X, ArrowRight } from '@lucide/astro';
import Container from '@/components/ui/Container.astro';
import Logo from '@/components/ui/Logo.astro';
import Button from '@/components/ui/Button.astro';
import ModuleIcon from '@/components/ui/ModuleIcon.astro';
import { site, modules, solutions, mainNav, ctaDemo } from '@/config/site';

// En build statique (format "file"), le chemin peut se terminer par .html : on le normalise.
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
const [logiciel, ...otherLinks] = mainNav;
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent bg-white/95 backdrop-blur transition-[border-color,box-shadow] data-[scrolled]:border-line data-[scrolled]:shadow-sm"
>
  <Container class="flex h-16 items-center justify-between gap-6 lg:h-18">
    <a href="/" class="rounded-md" aria-label={`${site.name} — accueil`}>
      <Logo />
    </a>

    <!-- Navigation ordinateur -->
    <nav aria-label="Navigation principale" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        <li>
          <a
            href={logiciel.href}
            class="nav-link"
            aria-current={isActive(logiciel.href) ? 'page' : undefined}
          >
            {logiciel.label}
          </a>
        </li>

        <li class="relative" data-dropdown>
          <button
            type="button"
            class="nav-link inline-flex items-center gap-1"
            aria-expanded="false"
            aria-controls="dd-fonctionnalites"
            data-dropdown-trigger
          >
            Fonctionnalités
            <ChevronDown class="size-4 transition-transform" aria-hidden="true" />
          </button>
          <div
            id="dd-fonctionnalites"
            class="dropdown-panel w-[40rem] -translate-x-1/3"
            hidden
            data-dropdown-panel
          >
            <ul class="grid grid-cols-2 gap-1">
              {modules.map((m) => (
                <li>
                  <a
                    href={`/fonctionnalites/${m.slug}`}
                    class="group flex gap-3 rounded-lg p-3 hover:bg-surface"
                  >
                    <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-fresh-50 text-fresh-700 group-hover:bg-fresh-100">
                      <ModuleIcon slug={m.slug} />
                    </span>
                    <span>
                      <span class="block text-sm font-semibold text-brand-800">{m.label}</span>
                      <span class="block text-xs leading-snug text-muted">{m.summary}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <a
              href="/fonctionnalites"
              class="mt-2 flex items-center justify-between rounded-lg bg-surface px-4 py-3 text-sm font-semibold text-brand-700 hover:bg-brand-50"
            >
              Voir toutes les fonctionnalités
              <ArrowRight class="size-4" aria-hidden="true" />
            </a>
          </div>
        </li>

        <li class="relative" data-dropdown>
          <button
            type="button"
            class="nav-link inline-flex items-center gap-1"
            aria-expanded="false"
            aria-controls="dd-solutions"
            data-dropdown-trigger
          >
            Solutions
            <ChevronDown class="size-4 transition-transform" aria-hidden="true" />
          </button>
          <div id="dd-solutions" class="dropdown-panel w-80" hidden data-dropdown-panel>
            <ul class="space-y-1">
              {solutions.map((s) => (
                <li>
                  <a href={s.href} class="block rounded-lg p-3 hover:bg-surface">
                    <span class="block text-sm font-semibold text-brand-800">{s.label}</span>
                    <span class="block text-xs text-muted">{s.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </li>

        {otherLinks.map((l) => (
          <li>
            <a href={l.href} class="nav-link" aria-current={isActive(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      {site.appLoginUrl && (
        <div class="hidden lg:block">
          <Button href={site.appLoginUrl} variant="ghost">
            Se connecter
          </Button>
        </div>
      )}
      <div class="hidden sm:block">
        <Button href={ctaDemo.href}>{ctaDemo.label}</Button>
      </div>
      <button
        type="button"
        class="grid size-10 place-items-center rounded-lg text-brand-700 hover:bg-brand-50 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Ouvrir le menu"
        data-mobile-open
      >
        <Menu class="size-6" aria-hidden="true" />
      </button>
    </div>
  </Container>
</header>

<!-- Navigation mobile -->
<div
  id="mobile-nav"
  class="fixed inset-0 z-50 flex flex-col overflow-y-auto bg-white lg:hidden"
  hidden
  data-mobile-panel
>
  <div class="flex h-16 shrink-0 items-center justify-between border-b border-line px-4 sm:px-6">
    <a href="/" aria-label={`${site.name} — accueil`}>
      <Logo />
    </a>
    <button
      type="button"
      class="grid size-10 place-items-center rounded-lg text-brand-700 hover:bg-brand-50"
      aria-label="Fermer le menu"
      data-mobile-close
    >
      <X class="size-6" aria-hidden="true" />
    </button>
  </div>
  <nav aria-label="Navigation mobile" class="flex-1 px-4 py-6 sm:px-6">
    <a href={logiciel.href} class="mobile-link">
      {logiciel.label}
    </a>

    <p class="mt-6 px-3 text-xs font-semibold tracking-wide text-muted uppercase">
      Fonctionnalités
    </p>
    <ul class="mt-2 grid gap-1 sm:grid-cols-2">
      {modules.map((m) => (
        <li>
          <a
            href={`/fonctionnalites/${m.slug}`}
            class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-brand-800 hover:bg-surface"
          >
            <span class="text-fresh-700">
              <ModuleIcon slug={m.slug} />
            </span>
            <span class="text-sm font-medium">{m.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-6 px-3 text-xs font-semibold tracking-wide text-muted uppercase">Solutions</p>
    <ul class="mt-2 grid gap-1">
      {solutions.map((s) => (
        <li>
          <a href={s.href} class="mobile-link">
            {s.label}
          </a>
        </li>
      ))}
    </ul>

    <ul class="mt-6 grid gap-1 border-t border-line pt-6">
      {otherLinks.map((l) => (
        <li>
          <a href={l.href} class="mobile-link">
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="sticky bottom-0 border-t border-line bg-white p-4 sm:px-6">
    <Button href={ctaDemo.href} size="lg" class="w-full">
      {ctaDemo.label}
    </Button>
  </div>
</div>

<style>
  @reference '../../styles/global.css';

  .nav-link {
    @apply rounded-md px-3 py-2 text-sm font-medium text-brand-800 transition-colors hover:bg-brand-50 hover:text-brand-700;
  }
  .nav-link[aria-current='page'] {
    @apply text-fresh-700;
  }
  .nav-link[aria-expanded='true'] {
    @apply bg-brand-50;
  }
  .nav-link[aria-expanded='true'] :global(svg) {
    @apply rotate-180;
  }
  .dropdown-panel {
    @apply absolute top-full left-0 mt-2 rounded-xl border border-line bg-white p-3 shadow-lift;
  }
  .mobile-link {
    @apply block rounded-lg px-3 py-2.5 text-base font-semibold text-brand-800 hover:bg-surface;
  }
</style>

<script>
  const header = document.getElementById('site-header');

  // Bordure et ombre de l'en-tête au défilement
  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Menus déroulants (ordinateur)
  const dropdowns = [...document.querySelectorAll<HTMLElement>('[data-dropdown]')];
  const closeAll = (except?: HTMLElement) => {
    for (const dd of dropdowns) {
      if (dd === except) continue;
      dd.querySelector('[data-dropdown-trigger]')?.setAttribute('aria-expanded', 'false');
      dd.querySelector<HTMLElement>('[data-dropdown-panel]')?.setAttribute('hidden', '');
    }
  };
  for (const dd of dropdowns) {
    const trigger = dd.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
    const panel = dd.querySelector<HTMLElement>('[data-dropdown-panel]');
    if (!trigger || !panel) continue;
    trigger.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') === 'true';
      closeAll(dd);
      trigger.setAttribute('aria-expanded', String(!open));
      panel.toggleAttribute('hidden', open);
    });
    dd.addEventListener('focusout', (e) => {
      if (!dd.contains(e.relatedTarget as Node | null)) closeAll();
    });
  }
  document.addEventListener('click', (e) => {
    if (!dropdowns.some((dd) => dd.contains(e.target as Node))) closeAll();
  });

  // Menu mobile
  const panel = document.querySelector<HTMLElement>('[data-mobile-panel]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-mobile-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-mobile-close]');
  const setMobile = (open: boolean) => {
    if (!panel || !openBtn) return;
    panel.toggleAttribute('hidden', !open);
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    (open ? closeBtn : openBtn)?.focus();
  };
  openBtn?.addEventListener('click', () => setMobile(true));
  closeBtn?.addEventListener('click', () => setMobile(false));
  window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
    if (e.matches && panel && !panel.hidden) setMobile(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const openTrigger = document.querySelector<HTMLElement>(
      '[data-dropdown-trigger][aria-expanded="true"]',
    );
    closeAll();
    openTrigger?.focus();
    if (panel && !panel.hidden) setMobile(false);
  });
</script>
