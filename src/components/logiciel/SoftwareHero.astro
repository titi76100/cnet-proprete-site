---
import { Gift, Percent } from '@lucide/astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import ModuleHub from '@/components/mockups/ModuleHub.astro';
import { ctaDemo, ctaTrial, offer } from '@/config/site';
---

<section class="relative overflow-hidden bg-gradient-to-b from-brand-50 via-white to-white">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 right-0 size-[36rem] rounded-full bg-fresh-100/60 blur-3xl"
  ></div>
  <Container class="relative grid items-center gap-14 py-14 sm:py-20 lg:grid-cols-2 lg:py-20">
    <div>
      <p class="inline-flex items-center rounded-full bg-white px-3 py-1 text-xs font-semibold text-fresh-700 ring-1 ring-fresh-200">
        Le logiciel CNet Propreté
      </p>
      <h1 class="mt-5 text-4xl leading-[1.1] font-extrabold sm:text-5xl">
        Un logiciel unique pour <span class="text-fresh-700">organiser, contrôler et suivre</span>{' '}
        vos prestations
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
        CNet Propreté est un logiciel de gestion conçu pour les entreprises de nettoyage et les
        structures d’insertion. Il réunit en neuf modules la gestion de vos salariés, de vos sites
        et de vos interventions, au bureau comme sur le terrain.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href={ctaDemo.href} size="lg">
          {ctaDemo.label}
        </Button>
        <Button href={ctaTrial.href} variant="secondary" size="lg">
          {ctaTrial.label}
        </Button>
      </div>
      <ul class="mt-6 flex flex-col gap-2 text-sm font-medium text-brand-700 sm:flex-row sm:gap-6">
        <li class="inline-flex items-center gap-2">
          <Gift class="size-4 text-fresh-700" aria-hidden="true" />
          Essai gratuit de {offer.trialDays} jours
        </li>
        <li class="inline-flex items-center gap-2">
          <Percent class="size-4 text-fresh-700" aria-hidden="true" />
          {offer.annualDiscountPercent} % de réduction en paiement annuel
        </li>
      </ul>
    </div>
    <ModuleHub />
  </Container>
</section>
