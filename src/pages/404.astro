---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import { ctaDemo } from '@/config/site';
---

<BaseLayout title="Page introuvable" noindex>
  <Container size="narrow" class="py-24 text-center sm:py-32">
    <p class="text-sm font-semibold tracking-wide text-fresh-700 uppercase">Erreur 404</p>
    <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">Cette page n’est pas encore disponible</h1>
    <p class="mx-auto mt-5 max-w-xl text-lg text-muted">
      Le site CNet Propreté est en cours de construction : cette page sera bientôt en ligne, ou
      l’adresse saisie est incorrecte.
    </p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <Button href="/" size="lg">
        Retour à l’accueil
      </Button>
      <Button href={ctaDemo.href} variant="secondary" size="lg">
        {ctaDemo.label}
      </Button>
    </div>
  </Container>
</BaseLayout>
