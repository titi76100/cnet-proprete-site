{
  "name": "cnet-proprete-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Site commercial officiel de CNet Propreté",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
